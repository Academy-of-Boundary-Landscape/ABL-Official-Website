# Copy existing production values into Coolify runtime variables. Never regenerate secrets.
PG_USER=strapi
PG_DB=strapi_db
PG_PASSWORD=
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
JWT_SECRET=
# Rehearsals MUST override both values with isolated storage.
ABL_PG_VOLUME=abl_website_pgdata
ABL_UPLOADS_PATH=/home/deploy/abl_website/strapi-backend/public/uploads
# Frontend public URLs are build-time settings in frontend/.env.production.
# Backend variables above are runtime-only; do not enable build-time injection.
