######################
# 通用 / 根目录
######################
.DS_Store
node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vscode/
.idea/

# Legacy backend (unused)
backend/

######################
# Frontend (Vue)
######################
# Vue 构建输出
frontend/dist/
frontend/dist-ssr/

# 本地环境变量
frontend/.env.local
frontend/.env.*.local
# 备份文件
*.bak

# 测试覆盖率
frontend/coverage/

######################
# Backend (Strapi)
######################
# Strapi 系统生成文件
strapi-backend/.tmp/
strapi-backend/.cache/
strapi-backend/build/

strapi-backend/node_modules/
strapi-backend/dist/

# Strapi 环境变量 (非常重要！)
# 忽略所有真实 env 文件，只保留示例模板 (.env.example / .env.dev)
strapi-backend/.env
strapi-backend/.env.*
!strapi-backend/.env.example
!strapi-backend/.env.dev

# Strapi 上传的媒体文件 (建议忽略，改用云存储，详见下文)
# 注意：这里必须写 /* 而不是 /，否则父目录被整体排除，下面的 .gitkeep 例外不生效
strapi-backend/public/uploads/*
# 保留 .gitkeep 以防止文件夹丢失，但忽略里面的内容
!strapi-backend/public/uploads/.gitkeep

# 数据库文件 (如果你在开发环境使用 SQLite)
strapi-backend/database/.tmp/
strapi-backend/database/*.db
strapi-backend/database/*.db-journal

# Strapi 生成的 TypeScript 类型 (可选，建议忽略，让协作者本地生成)
# 如果团队强制要求类型同步，可以不忽略
# strapi-backend/types/generated/

# Strapi 版本检查缓存，每次启动都会变，不该进 git
strapi-backend/.strapi-updater.json


# 没用的设计素材
design_reference/

######################
# Docker Compose
######################
# Compose 环境变量 (含 PG_PASSWORD 等敏感信息)
.env
!frontend/.env.*
!strapi-backend/.env.*

# 备份文件 (含数据库导出)
backups/