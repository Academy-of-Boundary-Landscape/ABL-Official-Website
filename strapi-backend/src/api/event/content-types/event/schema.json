{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "event"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "isUrgent": {
      "type": "boolean"
    },
    "category": {
      "type": "enumeration",
      "enum": ["devlog", "announcement", "release"]
    },
    "mainContent": {
      "type": "dynamiczone",
      "components": [
        "embedding.product-embed",
        "content-block.content-block",
        "embedding.iframe-embed",
        "embedding.link-embed",
        "embedding.pdf-embed",
        "embedding.file-embed"
      ]
    },
    "relatedWork": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::work.work",
      "inversedBy": "news"
    }
  }
}
