# Strapi Production Environment Template
#
# 复制为 .env 后，**必须把每一个 __GENERATE_ME__ 换成新生成的值**：
#   openssl rand -base64 48
#
# ⚠️ 这个仓库是公开的。写进本文件的任何真实密钥等于公开发布。
#    2026-08-01 之前本文件确实带着一整套可用的密钥（含 ADMIN_JWT_SECRET
#    与 DATABASE_PASSWORD）。已清除，但 git 历史里永久留存——
#    那批密钥一律作废，任何环境都不要再用。
#
# .env 本身是 git-ignored 的，真实密钥只应存在于服务器上。
#
# 架构：Strapi 跑在宿主机（PM2），PostgreSQL 跑在 Docker，
#       数据库经 127.0.0.1:5433 访问（宿主机 5432 被系统 postgres 占了）。
#
# NODE_ENV 不写在这里——由 pm2 的 ecosystem.config.js 设为 production。
#   两处各写一份会漂移，以 ecosystem.config.js 为准。

# Server
HOST=0.0.0.0
PORT=1337
URL=https://api.abl.secret-sealing.club

# Secrets —— 逐个 `openssl rand -base64 48` 生成，不要复用任何示例值
# APP_KEYS 需要 4 个逗号分隔的值
APP_KEYS=__GENERATE_ME__,__GENERATE_ME__,__GENERATE_ME__,__GENERATE_ME__
API_TOKEN_SALT=__GENERATE_ME__
ADMIN_JWT_SECRET=__GENERATE_ME__
TRANSFER_TOKEN_SALT=__GENERATE_ME__
# ENCRYPTION_KEY 用于加密存储值（如第三方 provider 凭据）。
# 轮换前先确认没有已加密数据，否则会解不开。
ENCRYPTION_KEY=__GENERATE_ME__

# Database —— PostgreSQL in Docker
# DATABASE_PASSWORD 必须与 docker-compose.yml 里 postgres 服务的密码一致；
# 修改时两边要一起改，容器内还需 ALTER USER。
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=strapi_db
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=__GENERATE_ME__
DATABASE_SSL=false

# JWT（users-permissions 插件签发的用户 token）
JWT_SECRET=__GENERATE_ME__

# Transfer Token
STRAPI_TRANSFER_TOKEN_SALT=__GENERATE_ME__
