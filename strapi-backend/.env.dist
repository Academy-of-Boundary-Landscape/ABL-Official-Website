# Strapi Production Environment Template
# Copy to .env and fill in real secrets before deploying.
# WARNING: .env is git-ignored — NEVER commit real secrets.
#
# Architecture: Strapi runs on the HOST (PM2), PostgreSQL runs in Docker.
# Database is reached at 127.0.0.1:5433 (exposed by docker-compose; host 5432 is system postgres).

# Server
HOST=0.0.0.0
PORT=1337
URL=https://api.abl.secret-sealing.club

# Secrets — generate new ones with: openssl rand -base64 32
APP_KEYS=CHANGE_ME_key1==,CHANGE_ME_key2==,CHANGE_ME_key3==,CHANGE_ME_key4==
API_TOKEN_SALT=CHANGE_ME_salt==
ADMIN_JWT_SECRET=CHANGE_ME_admin_jwt==
TRANSFER_TOKEN_SALT=CHANGE_ME_transfer_salt==
ENCRYPTION_KEY=CHANGE_ME_encryption_key==

# Database — PostgreSQL in Docker, exposed on localhost
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=strapi_db
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=CHANGE_ME_db_password
DATABASE_SSL=false

# JWT
JWT_SECRET=CHANGE_ME_jwt_secret==

# Transfer Token
STRAPI_TRANSFER_TOKEN_SALT=CHANGE_ME_transfer_token_salt==
