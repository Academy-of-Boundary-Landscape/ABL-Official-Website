{
    "kind": "collectionType",
    "collectionName": "products",
    "info": {
        "singularName": "product",
        "pluralName": "products",
        "displayName": "product"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "title": {
            "type": "string",
            "required": true
        },
        "slug": {
            "type": "uid",
            "required": true
        },
        "category": {
            "type": "enumeration",
            "enum": [
                "Kyomoneko",
                "Arclic",
                "Book",
                "Cloth",
                "Disc",
                "Electronic",
                "Figure",
                "Goods",
                "Plush",
                "Virtual",
                "Special"
            ]
        },
        "coverImage": {
            "type": "media",
            "multiple": false,
            "required": true,
            "allowedTypes": [
                "files",
                "images"
            ]
        },
        "releaseDate": {
            "type": "date",
            "required": true
        },
        "releaseEvent": {
            "type": "string",
            "required": true
        },
        "description": {
            "type": "richtext",
            "required": true
        },
        "productStaff": {
            "type": "component",
            "component": "staff.staff",
            "repeatable": true,
            "required": true
        },
        "available": {
            "type": "boolean"
        },
        "price": {
            "type": "decimal"
        },
        "storageId": {
            "type": "string",
            "required": true
        }
    }
}
