# Server
HOST=0.0.0.0
PORT=1337
# 开发环境通常不需要 URL，或者指向本地
# URL=http://localhost:1337

# Secrets
# 注意：以下是开发用的假密钥 (Dummy Keys)，符合 Strapi 格式要求。
# 协作者复制此文件为 .env 后，可以直接启动项目，无需额外生成。
# ⚠️ 严禁在生产环境使用这些 Key！
APP_KEYS=toBeModifiedKey1==,toBeModifiedKey2==,toBeModifiedKey3==,toBeModifiedKey4==
API_TOKEN_SALT=toBeModifiedSalt==
ADMIN_JWT_SECRET=toBeModifiedAdminSecret==
TRANSFER_TOKEN_SALT=toBeModifiedTransferSalt==
ENCRYPTION_KEY=toBeModifiedEncryptionKey==

# Database (已配置为 SQLite，无需安装 MySQL 即可运行)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# JWT
JWT_SECRET=toBeModifiedJwtSecret==

# Transfer Token
STRAPI_TRANSFER_TOKEN_SALT=devTransferTokenSalt