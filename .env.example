# Docker Compose env vars — copy to .env and fill real values
# WARNING: .env is git-ignored — NEVER commit it
#
# Strapi runs directly on the host (PM2), NOT in Docker.
# Only PostgreSQL + Frontend (nginx) are containerized.

PG_USER=strapi
PG_PASSWORD=change_me_to_a_strong_password
PG_DB=strapi_db
